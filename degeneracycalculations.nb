Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"CircleTimes", "[", 
    RowBox[{"A_", ",", "B_"}], "]"}], " ", ":=", " ", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{"A", ",", "B"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Commute", "[", 
     RowBox[{"A_", ",", "B_"}], "]"}], " ", ":=", " ", 
    RowBox[{
     RowBox[{"A", ".", "B"}], " ", "-", " ", 
     RowBox[{"B", ".", "A"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   SubscriptBox["\[Sigma]", "w_"], ":=", 
   RowBox[{"PauliMatrix", "[", "w", "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  SubscriptBox["Spin", 
   RowBox[{"S0_", ",", "nn_"}]], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"S", "=", "S0"}], ",", "el", ",", "n"}], "}"}], ",", 
    RowBox[{
     RowBox[{"dim", "=", 
      RowBox[{
       RowBox[{"2", "*", "S"}], "+", "1"}]}], ";", 
     RowBox[{"m", "=", 
      RowBox[{"Range", "[", 
       RowBox[{
        RowBox[{"-", "S"}], ",", "S", ",", "1"}], "]"}]}], ";", 
     RowBox[{"mdash", "=", 
      RowBox[{"Range", "[", 
       RowBox[{
        RowBox[{"-", "S"}], ",", "S", ",", "1"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"n", "=", "nn"}], ";", 
     RowBox[{"el", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"dim", ",", "dim"}], "}"}]}], "]"}]}], ";", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"j", "=", "1"}], ",", 
       RowBox[{"j", "<", 
        RowBox[{"dim", "+", "1"}]}], ",", 
       RowBox[{"j", "++"}], ",", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", 
         RowBox[{"i", "<", 
          RowBox[{"dim", "+", "1"}]}], ",", 
         RowBox[{"i", "++"}], ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"n", "==", "\"\<i\>\""}], ",", 
           RowBox[{"el", "=", 
            RowBox[{"IdentityMatrix", "[", 
             RowBox[{
              RowBox[{"2", "S0"}], "+", "1"}], "]"}]}], ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"n", "==", "\"\<x\>\""}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"el", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "[", 
               RowBox[{"[", "j", "]"}], "]"}], "=", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "/", "2"}], ")"}], "*", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"KroneckerDelta", "[", 
                  RowBox[{
                   RowBox[{"mdash", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", 
                   RowBox[{
                    RowBox[{"m", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "+", "1"}]}], "]"}], "+", 
                 RowBox[{"KroneckerDelta", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"mdash", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "+", "1"}], ",", 
                   RowBox[{"m", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}], ")"}], 
               RowBox[{"Sqrt", "[", 
                RowBox[{
                 RowBox[{"S", 
                  RowBox[{"(", 
                   RowBox[{"S", "+", "1"}], ")"}]}], "-", 
                 RowBox[{
                  RowBox[{"mdash", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], 
                  RowBox[{"m", "[", 
                   RowBox[{"[", "j", "]"}], "]"}]}]}], "]"}]}]}], ",", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"n", "==", "\"\<y\>\""}], ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"el", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "[", 
                 RowBox[{"[", "j", "]"}], "]"}], "=", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"1", "/", "2"}], "I"}], ")"}], "*", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"KroneckerDelta", "[", 
                    RowBox[{
                    RowBox[{"mdash", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", 
                    RowBox[{
                    RowBox[{"m", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "+", "1"}]}], "]"}], "-", 
                   RowBox[{"KroneckerDelta", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"mdash", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "+", "1"}], ",", 
                    RowBox[{"m", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}], ")"}], 
                 RowBox[{"Sqrt", "[", 
                  RowBox[{
                   RowBox[{"S", 
                    RowBox[{"(", 
                    RowBox[{"S", "+", "1"}], ")"}]}], "-", 
                   RowBox[{
                    RowBox[{"mdash", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], 
                    RowBox[{"m", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}]}], "]"}]}]}], ",", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"n", "==", "\"\<z\>\""}], ",", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"el", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "[", 
                   RowBox[{"[", "j", "]"}], "]"}], "=", 
                  RowBox[{
                   RowBox[{"-", 
                    RowBox[{"KroneckerDelta", "[", 
                    RowBox[{
                    RowBox[{"mdash", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", 
                    RowBox[{"m", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}], 
                   RowBox[{"m", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}]}]}], "]"}]}], "]"}]}], 
            "]"}]}], "]"}]}], "]"}]}], "]"}], ";", "el"}]}], 
   "]"}]}]}], "Input",
